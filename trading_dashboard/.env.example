# =============================================================================
# Trading Dashboard - Environment Variables Template
# =============================================================================
# Setup:
#   1. Copy this file to ".env" in the same directory:
#        cp .env.example .env
#   2. Fill in your real values below.
#   3. NEVER commit the real ".env" - it is git-ignored.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Alpaca (paper trading only)
# -----------------------------------------------------------------------------
# Get keys at: https://alpaca.markets/  -> Paper Trading -> View API Keys
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here

# "true" for paper trading (recommended), "false" for live.
# This system is designed for paper trading only - leave as "true".
ALPACA_PAPER=true

# Endpoint. Leave the default for paper trading.
ALPACA_BASE_URL=https://paper-api.alpaca.markets


# -----------------------------------------------------------------------------
# Alerts (all optional - leave blank to disable)
# -----------------------------------------------------------------------------
# Console alerts are on by default. Set to "false" to silence.
ALERTS_CONSOLE=true

# Telegram alerts. Set ALERTS_TELEGRAM=true and provide a bot token + chat id.
# Create a bot via @BotFather, then talk to it to get your chat id.
ALERTS_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord alerts via incoming webhook URL.
ALERTS_DISCORD=false
DISCORD_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# Optional logging
# -----------------------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
