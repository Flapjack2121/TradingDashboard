# =============================================================================
# Trading Dashboard - Git Ignore Rules
# =============================================================================

# ---- Secrets & local config -------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ---- Runtime artifacts (created by config.py at import) ---------------------
_data_cache/
_models/
_exports/
_logs/

# Common alternative names
data_cache/
models/
exports/
logs/
*.joblib
*.pkl
*.pickle
*.h5
*.onnx

# ---- ML / Backtest outputs --------------------------------------------------
backtest_results/
trade_logs/
*.csv.gz
trades_*.csv
equity_curve_*.csv
feature_importance_*.csv

# Keep example/sample CSVs that may be checked in
!sample_*.csv
!example_*.csv

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/
share/python-wheels/
MANIFEST

# ---- Virtual environments ---------------------------------------------------
.venv/
venv/
env/
ENV/
.virtualenv/
pyvenv.cfg

# ---- Streamlit --------------------------------------------------------------
.streamlit/secrets.toml
.streamlit/cache/

# ---- Testing & coverage -----------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.nox/
.hypothesis/

# ---- Type checkers ----------------------------------------------------------
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# ---- Jupyter ----------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- IDE / Editor -----------------------------------------------------------
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.spyderproject
.spyproject
.ropeproject

# ---- OS junk ----------------------------------------------------------------
